{
  "name": "jaswa-helper",
  "private": true,
  "author": "JASWA",
  "description": "Local Steam companion for JASWA.",
  "main": "src/tray.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "http-mitm-proxy": "1.1.0"
  },
  "overrides": {
    "http-mitm-proxy": {
      "uuid": "11.1.0"
    }
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dk.jaswa.helper",
    "productName": "JASWA Helper",
    "artifactName": "JASWA-Helper-Setup.exe",
    "icon": "../public/favicon.ico",
    "directories": {
      "output": "../public"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../public/favicon.ico",
        "to": "favicon.ico"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "include": "build/uninstall-cleanup.nsh"
    },
    "win": {
      "signAndEditExecutable": false
    }
  }
}
