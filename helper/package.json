{
  "name": "jaswa-helper",
  "version": "1.0.63",
  "private": true,
  "type": "module",
  "author": "JASWA",
  "description": "Local Steam companion for JASWA.",
  "scripts": {
    "start": "tauri dev",
    "frontend:dev": "vite --host localhost --port 1420 --strictPort",
    "test": "npm run verify:command-contract && npm run verify:installer-upgrade && cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:command-contract": "node scripts/verify-command-contract.mjs",
    "verify:installer-upgrade": "node scripts/verify-installer-upgrade.mjs",
    "verify:dashboard-flow": "node scripts/verify-dashboard-flow.mjs",
    "build:frontend": "tsc --noEmit && vite build",
    "build": "tauri build --bundles nsis",
    "package": "node scripts/package.cjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
