{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jaswa",
  "compatibility_date": "2026-09-08",
  // The Worker only serves the game's artwork from R2 (worker/index.ts);
  // everything else is the static build, answered without running code.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/monster-images/*", "/rune-images/*"]
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "jaswa-artwork"
    }
  ]
}
